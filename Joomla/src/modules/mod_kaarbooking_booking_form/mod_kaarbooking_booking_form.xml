<?xml version="1.0" encoding="utf-8"?>
<extension type="module" client="site" method="upgrade">
    <name>MOD_KAARBOOKING_BOOKING_FORM</name><version>0.1.0</version><license>GPL-2.0-or-later</license>
    <description>MOD_KAARBOOKING_BOOKING_FORM_DESC</description>
    <namespace path="src">KaarBooking\Module\BookingForm</namespace>
    <files><folder module="mod_kaarbooking_booking_form">services</folder><folder>src</folder><folder>tmpl</folder><folder>language</folder></files>
    <config><fields name="params"><fieldset name="basic">
        <field name="layout_mode" type="list" default="horizontal" label="Layout"><option value="horizontal">Horizontal</option><option value="stacked">Stacked</option><option value="compact">Compact</option></field>
        <field name="show_one_way" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="Show one-way"><option value="1">JYES</option><option value="0">JNO</option></field>
        <field name="show_round_trip" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="Show round-trip"><option value="1">JYES</option><option value="0">JNO</option></field>
        <field name="show_airport" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="Show airport"><option value="1">JYES</option><option value="0">JNO</option></field>
        <field name="show_hourly" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="Show hourly"><option value="1">JYES</option><option value="0">JNO</option></field>
        <field name="show_day" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="Show half/full day"><option value="1">JYES</option><option value="0">JNO</option></field>
        <field name="alignment" type="list" default="inherit" label="Alignment"><option value="inherit">Inherit</option><option value="start">Start</option><option value="center">Centre</option><option value="end">End</option></field>
    </fieldset></fields></config>
</extension>
