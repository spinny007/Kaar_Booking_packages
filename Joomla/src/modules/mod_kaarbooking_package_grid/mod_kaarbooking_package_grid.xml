<?xml version="1.0" encoding="utf-8"?>
<extension type="module" client="site" method="upgrade">
    <name>MOD_KAARBOOKING_PACKAGE_GRID</name><version>0.4.0</version><license>GPL-2.0-or-later</license>
    <description>MOD_KAARBOOKING_PACKAGE_GRID_DESC</description><namespace path="src">KaarBooking\Module\PackageGrid</namespace>
    <files><folder module="mod_kaarbooking_package_grid">services</folder><folder>src</folder><folder>tmpl</folder><folder>language</folder></files>
    <config><fields name="params"><fieldset name="basic">
        <field name="limit" type="number" default="6" min="1" max="24" label="Packages to show" />
        <field name="columns" type="list" default="3" label="Columns"><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option></field>
        <field name="show_summary" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="Show summary"><option value="1">JYES</option><option value="0">JNO</option></field>
        <field name="show_duration" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="Show duration"><option value="1">JYES</option><option value="0">JNO</option></field>
        <field name="show_price" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="Show price"><option value="1">JYES</option><option value="0">JNO</option></field>
        <field name="show_details" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="Show included items"><option value="1">JYES</option><option value="0">JNO</option></field>
    </fieldset></fields></config>
</extension>


